# r11u53 — the grid's RUN ARTIFACTS are regenerated by run53.sh and are not
# committed: two Surelog trees, two databases and four dumps per arm.  What is
# committed is the SOURCE of each arm (grid/<arm>/dut.sv), the drivers, and the
# distilled readings in evidence/.
grid/*/slpp_all/
grid/*/*.uhdm
grid/*/*.dump
grid/*/*.log
grid/*/cmp.*
grid/*/rc.*
