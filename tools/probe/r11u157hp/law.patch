+                        UHDM::UhdmName(a->UhdmType()).c_str(), a->VpiLineNo(),
+                        a->VpiColumnNo(), a->VpiEndLineNo(), a->VpiEndColumnNo(),
+                        hp->VpiLineNo(), hp->VpiColumnNo());
