diff --git a/src/R221.h b/src/R221.h
new file mode 100644
index 000000000..973ff6c7e
--- /dev/null
+++ b/src/R221.h
@@ -0,0 +1,50 @@
+// r11u221 (the second adversarial verification of passes 216 and 215,
+// tools/probe/r11u221verify/README.md): every refinement reads its own
+// R11V221_<LAW>_OFF switch; R11V221_OFF drops all of them (the verified base's
+// bytes).  R11V221_TRACE=<dir> names every firing: one file per process,
+// `<dir>/<pid>.221`, its first line `OUT <-o path>`, then `<law> <detail>`.
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <unistd.h>
+
+namespace slang_uhdm {
+inline bool r11v221Law(const char* sw) {
+    if (getenv("R11V221_OFF") != nullptr)
+        return false;
+    return getenv(sw) == nullptr;
+}
+inline void tr221(const char* law, const std::string& detail = std::string()) {
+    static FILE* tf = []() -> FILE* {
+        const char* d = getenv("R11V221_TRACE");
+        if (!d)
+            return nullptr;
+        std::string fn = std::string(d) + "/" + std::to_string(getpid()) + ".221";
+        FILE* fp = fopen(fn.c_str(), "a");
+        if (!fp)
+            return nullptr;
+        std::string cl, prev, outp;
+        if (FILE* c = fopen("/proc/self/cmdline", "r")) {
+            int ch;
+            while ((ch = fgetc(c)) != EOF) {
+                if (ch == 0) {
+                    if (prev == "-o")
+                        outp = cl;
+                    prev = cl;
+                    cl.clear();
+                }
+                else
+                    cl += (char)ch;
+            }
+            fclose(c);
+        }
+        fprintf(fp, "OUT %s\n", outp.c_str());
+        return fp;
+    }();
+    if (tf) {
+        fprintf(tf, "%s %s\n", law, detail.c_str());
+        fflush(tf);
+    }
+}
+} // namespace slang_uhdm
