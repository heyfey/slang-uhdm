+// The line record that covers group-relative output line k.
+inline bool mapK(const Group& g, uint32_t k, std::string& file, uint32_t& line) {
+    for (size_t i = g.recs.size(); i-- > 0;) {
+        auto& r = g.recs[i];
+        bool q;
+        if (r.push)
+            q = r.k <= k && r.close >= 0 && k < g.recs[(size_t)r.close].k;
+        else
+            q = r.k <= k;
+        if (q) {
+            file = r.file;
+            line = r.line + (k - r.k);
+            return true;
+        }
+    }
+    return false;
+}
