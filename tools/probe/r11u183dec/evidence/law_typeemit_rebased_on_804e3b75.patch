+        return fp;
+    }();
+    if (tf) {
+        fprintf(tf, "%s\n", law);
+        fflush(tf);
+    }
+}
+static bool r11u183LawTE(const char* sw) {
+    if (getenv("R11U183_OFF") != nullptr)
